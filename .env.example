# Connexió a la base de dades (Prisma Postgres de Vercel).
# Si el teu "Storage" es diu "comissioBD", Vercel genera automàticament
# una variable BD_POSTGRES_URL — no cal que la creïs tu, ja hi és.
# Si li has posat un altre nom al Storage, mira el prefix a la pestanya
# Storage -> Quickstart i ajusta'l a prisma/schema.prisma.
BD_POSTGRES_URL="postgresql://usuari:contrasenya@host/basededades?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="genera-una-cadena-aleatoria-llarga"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (per pujar els logos)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Usuari staff inicial (usat pel seed en local, si el fas servir)
SEED_STAFF_USER="admin"
SEED_STAFF_PASS="canvia-aquesta-contrasenya"

# Clau secreta temporal per crear el primer usuari de staff via /api/setup
# (només cal si despleges directament des de GitHub, sense entorn local)
SETUP_SECRET="genera-una-cadena-aleatoria-i-esborra-la-quan-acabis"
